# Freelancer-Client Trust Platform — Environment Variables
# Copy this file to .env.local and fill in the values.

# ── AI Verification (Feature 6) ──────────────────────────────

# Required: API key for the AI provider (OpenAI or compatible)
NEXT_PUBLIC_AI_API_KEY=

# Optional: Override the API endpoint (defaults to OpenAI)
# NEXT_PUBLIC_AI_API_URL=https://api.openai.com/v1/chat/completions

# Optional: Override the model (defaults to gpt-4o-mini)
# NEXT_PUBLIC_AI_MODEL=gpt-4o-mini
