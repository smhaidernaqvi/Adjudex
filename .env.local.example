# Adjudex - Environment Variables
# Copy this file to .env.local and fill in the values.
#
# IMPORTANT: these values are read ONLY on the server (src/app/api/ai/route.ts).
# They must NOT use the NEXT_PUBLIC_ prefix - that would expose them to the
# browser.

# --- AI (requirement refinement + deliverable verification) ---

# Required: Google Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: which Gemini model to call.
# Defaults to "gemini-3.6-flash" when unset.
#
# Google retires pinned model ids without notice - gemini-2.5-flash now returns
# 404 "This model is no longer available to new users". Because AI requirement
# refinement is a mandatory gate, a dead model id blocks transaction creation
# entirely rather than just degrading one feature, so keep this easy to change.
GEMINI_MODEL=gemini-3.6-flash
